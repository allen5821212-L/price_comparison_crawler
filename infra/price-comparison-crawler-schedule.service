[Unit]
Description=Queue scheduled price comparison crawler refresh

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/price_comparison_crawler
ExecStart=/bin/bash -lc 'source /home/ubuntu/.user_env; source /opt/.manus/webdev.sh.env; exec /usr/bin/python3 /home/ubuntu/price_comparison_crawler/crawler/enqueue_scheduled_job.py'
